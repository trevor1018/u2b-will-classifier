# ===== YouTube Data API v3 =====
# Get a free key at https://console.cloud.google.com/apis/credentials
# (10,000 units/day free, plenty for one channel)
YOUTUBE_API_KEY=your-youtube-api-key-here

# Channel ID for X調查 (already known — no need to change)
